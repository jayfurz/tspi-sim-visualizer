# Git LFS routing for Unity binary assets. Inert until matching files are added;
# requires git-lfs on each clone (git lfs install) before the first asset import.
# Scoped to the Unity project so docs/schemas/goldens elsewhere stay plain git.
# Unity .asset/.unity/.prefab files stay text — they are YAML under force-text
# serialization and diff/merge like source.

# Textures & images
unity/TspiViewer/Assets/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.tga filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.tif filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
unity/TspiViewer/Assets/**/*.gif filter=lfs diff=lfs merge=lfs -text

