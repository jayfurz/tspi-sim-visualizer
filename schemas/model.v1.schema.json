{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi-sim.local/schemas/model.v1.schema.json",
  "title": "tspi-model/1",
  "description": "Vehicle model file (<name>.json in a models/ dir). All parameters NOTIONAL — keep real performance data out of this repo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "mass_kg"],
  "properties": {
    "schema": { "const": "tspi-model/1" },
    "kind": { "enum": ["aircraft", "ship", "munition"] },
    "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
    "g_limit_max": { "type": "number", "exclusiveMinimum": 0, "default": 9.0 },
    "accel_long_max_mps2": { "type": "number", "exclusiveMinimum": 0, "default": 6.0 },
    "accel_vert_max_mps2": { "type": "number", "exclusiveMinimum": 0, "default": 30.0 },
    "speed_max_mps": { "type": "number", "exclusiveMinimum": 0, "default": 600.0 },
    "boost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thrust_n", "duration_s"],
      "properties": {
        "thrust_n": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 }
      }
    },
    "drag_cda_m2": { "type": "number", "minimum": 0, "default": 0 },
    "pronav_gain_default": { "type": "number", "minimum": 0, "default": 4.0 },
    "fuze_radius_m": { "type": "number", "exclusiveMinimum": 0, "default": 10.0 },
    "max_flight_time_s": { "type": "number", "exclusiveMinimum": 0, "default": 120.0 },
    "rotational": {
      "description": "Rigid-body rotational dynamics (aircraft only). Presence selects torque-integrated attitude instead of flight-path synthesis. All values NOTIONAL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["inertia_kgm2", "max_torque_nm"],
      "properties": {
        "inertia_kgm2": {
          "description": "Principal moments of inertia [Ixx, Iyy, Izz], body axes, kg·m².",
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "max_torque_nm": {
          "description": "Control torque authority per body axis [roll, pitch, yaw], N·m.",
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "attitude_kp": { "type": "number", "exclusiveMinimum": 0, "default": 9.0 },
        "attitude_kd": { "type": "number", "minimum": 0, "default": 6.0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "munition" } }, "required": ["kind"] },
      "then": { "not": { "required": ["rotational"] } }
    }
  ]
}
