<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared with Unity: this folder is also a UPM package (see package.json).
       Constraints: netstandard2.1, zero package dependencies, C# 9, no nullable
       annotations, no UnityEngine references. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Tspi.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
